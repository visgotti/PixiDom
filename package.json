{
  "name": "pixidom.js",
  "version": "1.0.0",
  "description": "A lightweight UI component library for PixiJS - text inputs, buttons, toggles, sliders, and scrollable lists",
  "keywords": [
    "pixi",
    "pixijs",
    "ui",
    "components",
    "textfield",
    "button",
    "toggle",
    "slider",
    "scrolllist",
    "canvas",
    "webgl",
    "game",
    "interactive"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.mjs",
    "dist/**/*.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "dist/**/*.d.cts",
    "!dist/pixi-bootstrap.d.ts",
    "!dist/**/*.d.ts.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "pixi.js": ">=4.0.0"
  },
  "type": "commonjs",
  "sideEffects": [
    "./dist/index.cjs",
    "./dist/index.es.mjs",
    "./dist/pixidom.js"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.es.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/pixidom.js",
  "jsdelivr": "dist/pixidom.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.es.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "visgotti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visgotti/PixiDom.git"
  },
  "bugs": {
    "url": "https://github.com/visgotti/PixiDom/issues"
  },
  "homepage": "https://github.com/visgotti/PixiDom#readme",
  "gitHead": "df7f3846a9b24191ca1d14154c276bcd3aa59040"
}
